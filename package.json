{
  "name": "dept_skeleton",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    ">>> FUNCTIONAL TESTS <<<": "To run tests on various browsers run the below",
    "chrome": "playwright test --grep @chrome --project=\"chromium\"",
    "safari": "playwright test --grep @safari --project=\"safari\"",
    "firefox": "playwright test --grep @ff --project=\"firefox\"",
    ">>> REGRESSION TESTS <<<": "Tests to assist with regression",
    "sitemap": "playwright test --grep @scan_sitemap --project=\"chromium\"",
    "sanity": "playwright test --grep @sanity --project=\"chromium\"",
    "redirections": "playwright test --grep @redirections --project=\"chromium\"",
    "a11y": "playwright test --grep @a11y --project=\"chromium\"",
    "a11y-sitemap": "playwright test --grep @sitemap_a11y --project=\"chromium\"",
    "links": "playwright test --grep @links --project=\"chromium\"",
    "links-sitemap": "playwright test --grep @sitemap_links --project=\"chromium\"",
    "report": "node scripts/combine-reports.mjs",
    "lh": "unlighthouse --config unlighthouse.config.ts --output-path ./lh-report",
    "lh-ci": "unlighthouse-ci",
    "mapping": "playwright test --grep @map --project=\"chromium\"",
    ">>> VISUAL TESTS <<<": "Before running a visual test please change snapshot path in playwright_config.ts",
    "visual-sitemap-desktop-update": "playwright test --grep @vis-sitemap --project=\"chromium\"  --update-snapshots",
    "visual-sitemap-desktop": "playwright test --grep @vis-sitemap --project=\"chromium\"",
    "visual-desktop-update": "playwright test --grep @visual --project=\"chromium\" --update-snapshots",
    "visual-desktop": "playwright test --grep @visual --project=\"chromium\"",
    "visual-mobile": "playwright test --grep @visual --project=\"Mobile Chrome\"",
    "visual-all": "playwright test --grep @visual --project=\"chromium sm\" --project=\"chromium md\" --project=\"chromium lg\" --project=\"chromium xl\"",
    "visual-sm": "playwright test --grep @visual --project=\"chromium sm\"",
    "visual-md": "playwright test --grep @visual --project=\"chromium md\"",
    "visual-lg": "playwright test --grep @visual --project=\"chromium lg\"",
    "visual-xl": "playwright test --grep @visual --project=\"chromium xl\"",
    ">>>GNI TESTS <<<": "Tests to assist with regression",
    "search-test": "playwright test --grep @search --project=\"chromium\"",
     "footer": "playwright test --grep @footer --project=\"chromium\"",
      "navbar": "playwright test --grep @navbar --project=\"chromium\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/mcp": "^0.0.45",
    "@playwright/test": "^1.47.2",
    "@types/dotenv": "^8.2.3",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^22.6.1",
    "axe-html-reporter": "^2.2.11",
    "axe-playwright": "^2.0.2",
    "axios": "1.7.7",
    "cheerio": "^1.0.0",
    "dotenv": "^17.2.3",
    "unlighthouse": "^0.17.4"
  },
  "dependencies": {
    "@unlighthouse/cli": "^0.17.4",
    "json2csv": "6.0.0-alpha.2",
    "p-limit": "^6.1.0"
  }
}
